generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentRole {
  owner
  editor
  commenter
  viewer
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())

  memberships   Membership[]
  documentAcls  DocumentAcl[]
  documentsMade Document[]     @relation("DocumentCreatedBy")
  updatesWritten DocumentUpdate[]
  snapshotsMade  DocumentSnapshot[]
  commentThreadsStarted CommentThread[]
  comments       Comment[]
  mentionedIn    CommentMention[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsCaused   Notification[] @relation("NotificationActor")
  shareLinksCreated     ShareLink[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships Membership[]
  documents   Document[]
}

// A user's membership in a workspace. Workspace-level role is coarse;
// fine-grained access happens per document via DocumentAcl.
model Membership {
  id          String   @id @default(cuid())
  role        DocumentRole @default(editor)
  createdAt   DateTime @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Document {
  id          String   @id @default(cuid())
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User      @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  // Nested pages: a document may live under another document. `position`
  // orders siblings for drag-to-reparent.
  parentId    String?
  parent      Document?  @relation("DocumentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Document[] @relation("DocumentTree")
  position    Int        @default(0)

  // Plain-text mirror of the Yjs content, refreshed by the WS server after
  // updates are persisted (tags stripped from the Yjs XmlFragment's
  // string form). Powers workspace search without a second sync channel.
  searchText  String   @default("")

  acl         DocumentAcl[]
  updates     DocumentUpdate[]
  snapshots   DocumentSnapshot[]
  commentThreads CommentThread[]
  shareLinks  ShareLink[]

  @@index([workspaceId])
  @@index([parentId])
}

// Per-document access control. Explicit rows override the implicit
// workspace membership; a workspace member with no row here has no access.
model DocumentAcl {
  id         String       @id @default(cuid())
  role       DocumentRole
  createdAt  DateTime     @default(now())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([documentId])
}

// Append-only log of binary Yjs updates. This is the source of truth;
// a room is reconstructed by replaying every row in order.
model DocumentUpdate {
  id         BigInt   @id @default(autoincrement())
  data       Bytes
  createdAt  DateTime @default(now())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([documentId, id])
}

// Periodic compacted state. Serves two purposes distinguished by
// `compactedThroughId`:
//   - null:      a user-facing named version (phase 3 history panel).
//                Kept forever; `data` is a full encoded state, so
//                restoring from it never depends on the update log.
//   - non-null:  an internal compaction checkpoint (phase 4). Marks that
//                every DocumentUpdate row up to and including that id is
//                summarized in `data` and has been deleted. Reconstruction
//                starts from the latest checkpoint instead of replaying
//                from empty, which is what keeps cold-load time bounded
//                as the log would otherwise grow forever.
model DocumentSnapshot {
  id                  String   @id @default(cuid())
  data                Bytes
  label               String?
  compactedThroughId  BigInt?
  createdAt           DateTime @default(now())

  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([documentId, compactedThroughId])
}

// One thread per commented range. The anchor is a Yjs RelativePosition
// (encoded, from y-prosemirror's absolutePositionToRelativePosition) for
// each end of the original selection, NOT a character offset - offsets
// are exactly what the spec calls out as "the obvious approach and
// they're wrong under concurrency". Re-resolving to an absolute range on
// every render is what makes the anchor survive concurrent edits, and
// what lets us detect an orphaned thread (both ends resolve to null once
// the commented text itself has been deleted).
model CommentThread {
  id              String   @id @default(cuid())
  anchorStart     Bytes
  anchorEnd       Bytes
  quotedText      String   // snapshot of the selection at creation time, shown if orphaned
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  comments        Comment[]

  @@index([documentId, resolved])
}

model Comment {
  id              String   @id @default(cuid())
  body            String
  createdAt       DateTime @default(now())

  threadId        String
  thread          CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  mentions        CommentMention[]

  @@index([threadId])
}

model CommentMention {
  id            String  @id @default(cuid())
  commentId     String
  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser User    @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
}

enum NotificationType {
  mention
  comment_reply
}

model Notification {
  id          String   @id @default(cuid())
  type        NotificationType
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  actorId     String
  actor       User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  documentId  String
  threadId    String?

  @@index([userId, read])
}

// A revocable, optionally password-protected read-only link. Anyone
// holding the token gets viewer access to exactly this document, without
// being a workspace member or having a DocumentAcl row - the token
// itself is the grant, scoped narrowly (one document, viewer only,
// revocable at any time) rather than a general-purpose credential.
model ShareLink {
  id            String    @id @default(cuid())
  token         String    @unique @default(cuid())
  passwordHash  String?
  revoked       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([documentId])
}
