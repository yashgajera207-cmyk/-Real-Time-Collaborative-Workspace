# Postgres connection used by Prisma (both Next.js app and the WS server)
DATABASE_URL="postgresql://quill:quill@localhost:5432/quill?schema=public"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Shared secret used to sign/verify short-lived WebSocket room tokens.
# Must be identical in the Next.js app and the standalone WS server.
WS_TOKEN_SECRET="replace-with-openssl-rand-base64-32"

# Where the browser connects for realtime sync
NEXT_PUBLIC_WS_URL="ws://localhost:1234"

# Standalone WS server
WS_PORT=1234

# Phase 4: room lifecycle and abuse protection (all optional, sensible
# defaults baked in if omitted)
IDLE_ROOM_EVICTION_MS=300000
MAX_DOCUMENT_BYTES=5242880

# Optional: error reporting for the WS server. Leave unset to disable.
SENTRY_DSN=
